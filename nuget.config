<?xml version="1.0" encoding="utf-8"?>
<!--
  EventHub package sources (Phase 1b flip ACTIVE).

  The eventhub feed URL is environment-driven so the same config works everywhere:
    * local dev   : EVENTHUB_NUGET_FEED=http://localhost:5555/v3/index.json
    * docker build: EVENTHUB_NUGET_FEED=http://host.docker.internal:5555/v3/index.json
    * shared/CI   : EVENTHUB_NUGET_FEED=https://<your-durable-feed>/v3/index.json
  NuGet expands %EVENTHUB_NUGET_FEED% at restore time. IT MUST BE SET — an unset value yields an
  invalid source and restore fails. (deploy/docker/README.nuget-feed.md documents the values; the
  service Dockerfiles set it via a build arg; CI sets it in the workflow env.)

  allowInsecureConnections=true permits the http:// dev/docker feeds; it is harmless for an https
  durable feed. packageSourceMapping keeps EventHub.* resolving ONLY from this feed, so a spoofed
  EventHub.* on nuget.org can never be substituted. Push auth uses NUGET_FEED_API_KEY.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="eventhub" value="%EVENTHUB_NUGET_FEED%" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="eventhub">
      <package pattern="EventHub.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
